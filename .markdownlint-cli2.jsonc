{
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false
  },
  "globs": [
    "README.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    ".github/pull_request_template.md",
    "docs/**/*.md",
    "!README_TEMPLATE.md",
    "!docs/TEMPLATE_BOOTSTRAP_CHECKLIST.md"
  ]
}
